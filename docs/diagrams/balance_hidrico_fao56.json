    { "id": "waterlog_check", "label": "¿Anegamiento?\n[s + P - ETa - TAW] >= 15 mm/día", "type": "diamond" },
    { "id": "viability_metric", "label": "Criterio de Viabilidad Fenológica\nRatio (Sum ETa / Sum ETc) >= 0.90\ny Días de Anegamiento <= 8 días", "type": "rectangle" }
