    { "id": "stress_ks", "label": "Factor de Estrés Hídrico Ks(t)\nSi (TAW - s) <= RAW: Ks = 1.0\nSi (TAW - s) > RAW: Ks = s / (TAW - RAW)", "type": "diamond" },
    { "id": "eta_calc", "label": "Evapotranspiración Real\nETa(t) = Ks(t) * ETc(t)", "type": "rectangle" },
