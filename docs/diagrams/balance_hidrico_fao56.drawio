<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="soil_input" value="Textura del Suelo
(52% Arena, 26% Arcilla, 1.8% MO)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="20" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="saxton_model" value="Ecuaciones Saxton &amp; Rawls (2006)
θFC (Capacidad Campo) &amp; θWP (Marchitez)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="140" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="taw_raw" value="Capacidades de Almacenamiento
TAW = 75.3 mm | RAW = 41.4 mm (p=0.55)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="260" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="weather_in" value="Reanálisis ERA5 Diario
Precipitación (P) y ET0 (Penman-Monteith)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="380" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="crop_curve" value="Curva Fenológica Maíz Blanco
Kc = [0.40 -&gt; 1.20 -&gt; 0.60] (120 días)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="500" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="etc_calc" value="Demanda Hídrica Teórica
ETc(t) = Kc(t) * ET0(t)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="620" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="stress_ks" value="Factor de Estrés Hídrico Ks(t)
Si (TAW - s) &lt;= RAW: Ks = 1.0
Si (TAW - s) &gt; RAW: Ks = s / (TAW - RAW)" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="740" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="eta_calc" value="Evapotranspiración Real
ETa(t) = Ks(t) * ETc(t)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="860" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="bucket_update" value="Actualización Cubo Edáfico
s(t+1) = min(TAW, max(0, s(t) + P(t) - ETa(t)))" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="980" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="waterlog_check" value="¿Anegamiento?
[s + P - ETa - TAW] &gt;= 15 mm/día" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1100" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="viability_metric" value="Criterio de Viabilidad Fenológica
Ratio (Sum ETa / Sum ETc) &gt;= 0.90
y Días de Anegamiento &lt;= 8 días" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1220" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="e_1" edge="1" parent="1" source="soil_input" target="saxton_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_2" edge="1" parent="1" source="saxton_model" target="taw_raw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_3" value="ET0 diario" edge="1" parent="1" source="weather_in" target="etc_calc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_4" value="Kc fenológico" edge="1" parent="1" source="crop_curve" target="etc_calc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_5" value="ETc(t)" edge="1" parent="1" source="etc_calc" target="stress_ks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_6" value="TAW &amp; RAW" edge="1" parent="1" source="taw_raw" target="stress_ks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_7" value="Coeficiente Ks" edge="1" parent="1" source="stress_ks" target="eta_calc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_8" value="Extracción ETa" edge="1" parent="1" source="eta_calc" target="bucket_update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_9" value="Entrada P(t)" edge="1" parent="1" source="weather_in" target="bucket_update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_10" edge="1" parent="1" source="bucket_update" target="waterlog_check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_11" value="Registro diario" edge="1" parent="1" source="waterlog_check" target="viability_metric" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_12" value="Suma acumulada" edge="1" parent="1" source="eta_calc" target="viability_metric" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
